class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        Arrays.sort(nums);
        List<Integer> res = new ArrayList<>();
        int cur = nums[0] + 1;
        for(int i = 1; i<nums.length ; ){
            if(cur < nums[i]){
                res.add(cur++);
            }else if(cur == nums[i]){
                i++;
                cur++;
            }
        }
        return res;
    }
}
