class Solution {
    public List<List<Integer>> shiftGrid(int[][] grid, int k) {
        List<List<Integer>> res = new ArrayList<>();
        k = k % (grid.length * grid[0].length);
        int si = k==0 ? 0 : grid.length - ((k-1) / grid[0].length) - 1;
        int sj = k==0 ? 0 : (grid[0].length - k%grid[0].length)%grid[0].length;
        List<Integer> cur = new ArrayList<>();
        for(int j=sj; j<grid[0].length; j++){
            cur.add(grid[si][j]);
            if(cur.size() == grid[0].length){
                res.add(cur);
                cur = new ArrayList<>();
            }
        }
        for(int i=si+1; i<grid.length; i++){
            for(int j=0; j<grid[0].length; j++){
                cur.add(grid[i][j]);
                if(cur.size() == grid[0].length){
                    res.add(cur);
                    cur = new ArrayList<>();
                }
            }
        }
        for(int i=0; i<si; i++){
            for(int j=0; j<grid[0].length; j++){
                cur.add(grid[i][j]);
                if(cur.size() == grid[0].length){
                    res.add(cur);
                    cur = new ArrayList<>();
                }
            }
        }
        for(int j=0; j<sj; j++){
            cur.add(grid[si][j]);
        }
        if(cur.size()>0){
            res.add(cur);
        }
        return res;
    }
}
