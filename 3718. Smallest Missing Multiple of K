class Solution {
    public int missingMultiple(int[] nums, int k) {
        Arrays.sort(nums);
        int cur = k;
        for(int i=0; i<nums.length;i++){
            if(nums[i] == cur){
                 cur += k;
            }
        }
        return cur;
    }
}



------------------------------------------------STREAMS------------------------------------------------------

class Solution {
    public int missingMultiple(int[] nums, int k) {
      Set<Integer> set = Arrays.stream(nums).boxed().collect(Collectors.toSet());
      return IntStream.iterate(k, cur -> cur+k).filter(cur -> !set.contains(cur)).findFirst().orElse(k);
    }
}
