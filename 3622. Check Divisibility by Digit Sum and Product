class Solution {
    public boolean checkDivisibility(int n) {
        int sum = 0;
        long prod = 1;
        int num = n;
        while(num > 0){
            sum += num%10;
            prod *= num%10;
            if((prod + sum) > n)
                return false;
            num = num/10;
        }
        if((prod + sum) > n)
                return false;
        return (n % ((int)prod + sum))==0;
    }
}
