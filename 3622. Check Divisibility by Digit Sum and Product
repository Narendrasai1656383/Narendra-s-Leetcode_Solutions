class Solution {
    public boolean checkDivisibility(int n) {
        int sum = 0;
        long prod = 1;
        int num = n;
        while(num > 0){
            sum += num%10;
            prod *= num%10;
            if((prod + sum) > n)
                return false;
            num = num/10;
        }
        if((prod + sum) > n)
                return false;
        return (n % ((int)prod + sum))==0;
    }
}



---------------------------------------------------USING STREAMS-------------------------------------------------------



class Solution {
    public boolean checkDivisibility(int n) {
        final long[] arr = {0,1};
        boolean isdivis = Stream.iterate(n, num -> num > 0, num -> num/10).map(num -> num%10).peek(digit -> {
            arr[0] += digit;
            arr[1] *= digit;
        }).allMatch(digit -> (arr[0] + arr[1]) <= n);
        if(!isdivis)
            return false;
        return (n % ((arr[0] + arr[1])))==0;
    }
}
