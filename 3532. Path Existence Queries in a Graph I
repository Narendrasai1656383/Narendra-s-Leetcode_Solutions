class Solution {
    public boolean[] pathExistenceQueries(int n, int[] nums, int maxDiff, int[][] queries) {
        boolean[] result = new boolean[queries.length];
        int[] connectedArr = new int[n];
        int connected = 0;
        for(int i=1; i<nums.length; i++){
            connectedArr[i] = Math.abs(nums[i] - nums[i-1]) <= maxDiff ? connected : ++connected;
        }
        for(int i=0; i<queries.length; i++){
            result[i] = connectedArr[queries[i][0]] == connectedArr[queries[i][1]];
        }
        return result;
    }
}
